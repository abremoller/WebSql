@using System.Globalization
@using System.Text
@inject IConnectionService ConnectionService
@inject IJSRuntime JSRuntime

@if (hasResults)
{
	<div class="mb-2">
		<HxButton Text="Export to CSV" Icon="BootstrapIcon.Download" Color="ThemeColor.Secondary" Size="ButtonSize.Small" OnClick="ExportToCsv" />
	</div>
	<table class="table table-bordered">
		<thead>
			<tr>
				@foreach (var col in ConnectionService.Table.Columns)
				{
					<th>@col.Name</th>
				}
			</tr>
		</thead>
		<tbody>
			@foreach (var row in ConnectionService.Table.Rows)
			{
				<tr>
					@foreach (var col in row)
					{
						<td>@col</td>
					}
				</tr>
			}
		</tbody>
	</table>
}

