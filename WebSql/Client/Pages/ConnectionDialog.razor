@using WebSql.Shared
@inject IConnectionService ConnectionService
@inject ILocalStorageService LocalStorage
@inject IHxMessengerService Messenger

<HxModal @ref="connectionDialog" Title="Connect To Server">
	<BodyTemplate>
		<div class="container overflow-hidden">
			<div class="row g-5">
				<div class="col">
					Server type:
				</div>
				<div class="col">
					<select class="form-select mb-2" value="@engine" @onchange="OnEngineChanged">
							<option value="@DatabaseEngine.SqlServer">@DatabaseEngine.SqlServer.DisplayName()</option>
							<option value="@DatabaseEngine.MySql">@DatabaseEngine.MySql.DisplayName()</option>
						</select>
				</div>
			</div>
			<div class="row g-5">
				<div class="col">
					Connection Profile:
				</div>
				<div class="col">
					<select class="form-select mb-2" @onchange="OnProfileSelected">
						<option value="">-- Select saved profile --</option>
						@foreach (var profile in connectionProfiles)
						{
							<option value="@profile.Name">@profile.Name</option>
						}
					</select>
					<div class="d-flex gap-2">
						<HxInputText @bind-Value="profileName" Label="" Placeholder="Profile name (optional)" CssClass="flex-grow-1" />
						<HxButton Text="Save" Size="ButtonSize.Small" Color="ThemeColor.Secondary" OnClick="SaveProfile" Icon="BootstrapIcon.Save" />
						@if (!string.IsNullOrEmpty(selectedProfileName))
						{
							<HxButton Text="Delete" Size="ButtonSize.Small" Color="ThemeColor.Danger" OnClick="DeleteProfile" Icon="BootstrapIcon.Trash" />
						}
					</div>
				</div>
			</div>
			<div class="row g-5">
				<div class="col">
					Server name:
				</div>
				<div class="col">
					<HxInputText @bind-Value="serverName" Label="" Placeholder="@(engine == DatabaseEngine.MySql ? "host or host:port (e.g. localhost:3306)" : "Enter server name")" />
					@if (serverDetails.Any())
					{
						<small class="text-muted">Recent servers:</small>
						<select class="form-select" @onchange="OnServerSelected">
							<option value="">-- Select from history --</option>
							@foreach (var server in serverDetails)
							{
								<option value="@server">@server</option>
							}
						</select>
					}
				</div>
			</div>
			@if (engine == DatabaseEngine.SqlServer)
			{
				<div class="row g-5">
					<div class="col">
						Integrated Security:
					</div>
					<div class="col">
						<HxCheckbox @bind-Value="integratedSecurity" />
					</div>
				</div>
			}
			<div class="row g-5">
				<div class="col">
					Login:
				</div>
				<div class="col">
					<HxInputText @bind-Value="login" Label="" Enabled="@(!integratedSecurity)" />
				</div>
			</div>
			<div class="row g-5">
				<div class="col">
					Password:
				</div>
				<div class="col">
					<HxInputText @bind-Value="password" Label="" InputType="InputType.Password" Enabled="@(!integratedSecurity)" />
				</div>
			</div>
			<div class="row g-5">
				<div class="col">
					Remember Details
				</div>
				<div class="col">
					<HxCheckbox @bind-Value="rememberDetails" Enabled="@(!integratedSecurity)" />
				</div>
			</div>
		</div>
	</BodyTemplate>
	<FooterTemplate>
		<HxButton Text="Connect" OnClick="HandleConnectClick" Color="ThemeColor.Primary" />
		<HxButton Text="Close" OnClick="HandleHideClick" Color="ThemeColor.Primary" />
	</FooterTemplate>
</HxModal>

@code
{
	private HxModal connectionDialog;
	private string password = "";
	private string login = "";
	private string serverName = "";
	private DatabaseEngine engine = DatabaseEngine.SqlServer;
	private bool integratedSecurity = true;
	private bool rememberDetails = true;
	private List<string> serverDetails = new List<string>();
	private List<ConnectionProfile> connectionProfiles = new List<ConnectionProfile>();
	private string profileName = "";
	private string selectedProfileName = "";

	public delegate void DialogClose();

	public event DialogClose OnDialogClose;

	public async Task Show()
	{
		// Load connection history from localStorage
		var history = await LocalStorage.GetItemAsync<List<string>>("ServerHistory");
		if (history != null)
		{
			serverDetails = history;
		}

		// Load connection profiles
		var profiles = await LocalStorage.GetItemAsync<List<ConnectionProfile>>("ConnectionProfiles");
		if (profiles != null)
		{
			connectionProfiles = profiles;
		}

		// Load last used credentials if remember details was checked
		var lastServer = await LocalStorage.GetItemAsync<string>("ServerName");
		var lastLogin = await LocalStorage.GetItemAsync<string>("Login");
		
		if (!string.IsNullOrEmpty(lastServer))
			serverName = lastServer;
		if (!string.IsNullOrEmpty(lastLogin))
			login = lastLogin;

		await connectionDialog.ShowAsync();
	}

	private async Task<bool> HandleConnectClick()
	{
		try
		{
			Console.WriteLine($"[ConnectionDialog] Connect clicked for server: {serverName}");
			
			ConnectionService.ConnectionDetails.Engine = engine;
			ConnectionService.ConnectionDetails.ServerName = serverName;
			ConnectionService.ConnectionDetails.Login = login;
			ConnectionService.ConnectionDetails.Password = password;
			ConnectionService.ConnectionDetails.IntegratedSecurity = integratedSecurity;
			
			// First connect to get session token
			Console.WriteLine("[ConnectionDialog] Calling ConnectAsync");
			bool connected = await ConnectionService.ConnectAsync();
			Console.WriteLine($"[ConnectionDialog] ConnectAsync returned: {connected}");
			
			if (connected)
			{
				// Then get the object explorer
				Console.WriteLine("[ConnectionDialog] Calling GetExplorerAsync");
				bool explorerLoaded = await ConnectionService.GetExplorerAsync();
				Console.WriteLine($"[ConnectionDialog] GetExplorerAsync returned: {explorerLoaded}");
				
				// Add server to connection history (max 10 entries)
				if (!serverDetails.Contains(serverName))
				{
					serverDetails.Insert(0, serverName);
					if (serverDetails.Count > 10)
						serverDetails.RemoveAt(10);
					
					await LocalStorage.SetItemAsync("ServerHistory", serverDetails);
				}
				
				// Save connection details (but NOT password!)
				if (rememberDetails && !integratedSecurity)
				{
					await LocalStorage.SetItemAsync($"ServerName", serverName);
					await LocalStorage.SetItemAsync($"Login", login);
				}

				Console.WriteLine("[ConnectionDialog] Hiding dialog and firing OnDialogClose");
				await connectionDialog.HideAsync();

				if (OnDialogClose != null)
					OnDialogClose();

				Console.WriteLine("[ConnectionDialog] Connection complete");
				return true;
			}
			else
			{
				Console.WriteLine("[ConnectionDialog] Connection failed");
				Messenger.AddError("Connection Failed", $"Unable to connect to {engine.DisplayName()}. Please check your server name and credentials.");
			}

			return false;
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[ConnectionDialog] Exception: {ex.Message}\\n{ex.StackTrace}");
			Messenger.AddError("Connection Error", $"An error occurred: {ex.Message}");
			return false;
		}
	}

	private async Task HandleHideClick()
	{
		await connectionDialog.HideAsync();
	}

	private void OnEngineChanged(ChangeEventArgs e)
	{
		if (Enum.TryParse<DatabaseEngine>(e.Value?.ToString(), out var selected))
		{
			engine = selected;
			// MySQL has no Windows/integrated login.
			if (engine == DatabaseEngine.MySql)
				integratedSecurity = false;
		}
	}

	private void OnServerSelected(ChangeEventArgs e)
	{
		if (e.Value is string selectedServer && !string.IsNullOrEmpty(selectedServer))
		{
			serverName = selectedServer;
		}
	}

	private async Task<AutosuggestDataProviderResult<string>> ProvideSuggestions(AutosuggestDataProviderRequest request)
	{
		var query = request.UserInput?.ToLower() ?? string.Empty;
		
		var filtered = string.IsNullOrEmpty(query) 
			? serverDetails 
			: serverDetails.Where(s => s.ToLower().Contains(query)).ToList();
		
		return await Task.FromResult(new AutosuggestDataProviderResult<string>
		{
			Data = filtered
		});
	}

	private void OnProfileSelected(ChangeEventArgs e)
	{
		if (e.Value is string profileName && !string.IsNullOrEmpty(profileName))
		{
			var profile = connectionProfiles.FirstOrDefault(p => p.Name == profileName);
			if (profile != null)
			{
				selectedProfileName = profileName;
				this.profileName = profileName;
				engine = profile.Engine;
					serverName = profile.ServerName;
				login = profile.Login;
				integratedSecurity = profile.IntegratedSecurity;
				StateHasChanged();
			}
		}
	}

	private async Task SaveProfile()
	{
		if (string.IsNullOrWhiteSpace(profileName))
		{
			Messenger.AddWarning("Profile name required", "Please enter a name for this connection profile.");
			return;
		}

		// Remove existing profile with same name
		connectionProfiles.RemoveAll(p => p.Name == profileName);

		// Add new/updated profile (without password for security)
		connectionProfiles.Add(new ConnectionProfile
		{
			Name = profileName,
			Engine = engine,
			ServerName = serverName,
			Login = login,
			IntegratedSecurity = integratedSecurity
		});

		await LocalStorage.SetItemAsync("ConnectionProfiles", connectionProfiles);
		Messenger.AddInformation($"Profile '{profileName}' saved successfully");
		selectedProfileName = profileName;
	}

	private async Task DeleteProfile()
	{
		if (string.IsNullOrEmpty(selectedProfileName))
			return;

		connectionProfiles.RemoveAll(p => p.Name == selectedProfileName);
		await LocalStorage.SetItemAsync("ConnectionProfiles", connectionProfiles);
		Messenger.AddInformation($"Profile '{selectedProfileName}' deleted");
		
		selectedProfileName = "";
		profileName = "";
		StateHasChanged();
	}

	public class ConnectionProfile
	{
		public string Name { get; set; } = "";
		public DatabaseEngine Engine { get; set; } = DatabaseEngine.SqlServer;
		public string ServerName { get; set; } = "";
		public string Login { get; set; } = "";
		public bool IntegratedSecurity { get; set; }
	}
}