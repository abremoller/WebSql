@page "/"
@using WebSql.Client.Components
@using static WebSql.Client.Pages.ConnectionDialog
@inject IConnectionService ConnectionService
@inject IHxMessengerService Messenger
@inject IJSRuntime JSRuntime

<div class="container-fluid">
	<div class="row">
		<div class="col-lg-auto" style="--hx-sidebar-brand-logo-background-color: var(--bs-primary);">
			<HxSidebar>
				<ItemsTemplate>
					<HxSidebarItem Text="Server" Icon="BootstrapIcon.Cloud">
						@if(connected && ConnectionService.ObjectExplorer != null)
						{
							<ObjectExplorer @ref="objectExplorer" OnDataLoaded="OnObjectExplorerDataLoaded" />
						}
					</HxSidebarItem>
					<HxSidebarItem Text="Connect" Icon="BootstrapIcon.CloudArrowUp">
						<HxButton OnClick="() => connectionStringDialog.Show()" />
					</HxSidebarItem>
				</ItemsTemplate>
				<FooterTemplate>
					@*<HxButton Text="Connect" Icon="BootstrapIcon.CloudArrowUp" OnClick="() => connectionStringDialog.Show()" />*@
					@*<HxSidebarFooter Text="Connect" Icon="BootstrapIcon.CloudArrowUp" />*@
					
				</FooterTemplate>
			</HxSidebar>
			

		</div>
		<div class="col">
			<HxAccordion StayOpen="true">
				<HxAccordionItem @ref="codeEditorAccordion">
					<BodyTemplate>
						@if(connected)
						{
							<HxButtonGroup>
								<HxDropdownButtonGroup>
									<HxDropdownToggleButton Color="ThemeColor.Secondary">@ConnectionService.SelectedDatabase</HxDropdownToggleButton>
									<HxDropdownMenu>
										@foreach(var v in ConnectionService.DatabaseNames)
										{
											<HxDropdownItem OnClick="() => ChangeSelectedDatabase(v)">@v</HxDropdownItem>	
										}
									</HxDropdownMenu>
								</HxDropdownButtonGroup>
								<HxButton Text="Run" Color="ThemeColor.Primary" Icon="BootstrapIcon.CaretRight" OnClick="() => RunQuery()"/>
							</HxButtonGroup>
						}
					<CodeEditor @ref="codeEditor" />
					</BodyTemplate>
				</HxAccordionItem>
			</HxAccordion>
		</div>
	</div>
	<div class="row">
	<HxTabPanel>
			<HxTab>
				<TitleTemplate>
					<HxCardText>
						<HxIcon Icon="BootstrapIcon.Table" />
						Results
					</HxCardText>
				</TitleTemplate>
				<Content>
					<ResultsGrid @ref="ResultsGrid" />
				</Content>
			</HxTab>
			<HxTab Id="messagesTab">
				<TitleTemplate>
					<HxCardText><HxIcon Icon="BootstrapIcon.PcDisplay" />Messages</HxCardText>
				</TitleTemplate>
				<Content>
					<MessagesPanel @ref="messagesPanel" />
				</Content>
			</HxTab>
		</HxTabPanel>
	</div>
</div>
	


@if (!connected)
{
	<div id="content">
		<ConnectionDialog @ref="connectionStringDialog" />
	</div>
}

@code
{
	HxAccordionItem codeEditorAccordion;
	ConnectionDialog connectionStringDialog;
	CodeEditor codeEditor;
	ObjectExplorer objectExplorer;
	ResultsGrid ResultsGrid;
	MessagesPanel messagesPanel;
	private bool connected;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			connectionStringDialog.OnDialogClose += ConnectionDialogClosed;
			await connectionStringDialog.Show();
			await codeEditorAccordion.ExpandAsync();
		}
	}

		public void ConnectionDialogClosed()
	{
		try
		{
			Console.WriteLine("[Index] ConnectionDialogClosed called");
			
			if (ConnectionService.ObjectExplorer != null)
			{
				Console.WriteLine("[Index] Setting connected = true");
				connected = true;
				StateHasChanged();
				
				// Queue the async work
				_ = LoadObjectExplorerAsync();
			}
			else
			{
				Console.WriteLine("[Index] WARNING: ConnectionService.ObjectExplorer is null!");
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[Index] Exception in ConnectionDialogClosed: {ex.Message}\n{ex.StackTrace}");
		}
	}

	private async Task LoadObjectExplorerAsync()
	{
		try
		{
			// Small delay to allow component to render
			await Task.Delay(10);
			
			Console.WriteLine($"[Index] objectExplorer ref is {(objectExplorer == null ? "NULL" : "set")}");
			Console.WriteLine("[Index] Adding ObjectExplorer data");
			if (objectExplorer != null)
			{
				await objectExplorer.AddObjectExplorerAsync(ConnectionService.ObjectExplorer);
			}
			
			Console.WriteLine("[Index] LoadObjectExplorerAsync complete");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[Index] Exception in LoadObjectExplorerAsync: {ex.Message}\n{ex.StackTrace}");
		}
	}

	public async Task RunQuery(bool confirmedDangerous = false)
	{
		try
		{
			messagesPanel?.Clear();
			
			var queryText = await codeEditor.GetValue();
			messagesPanel?.AddMessage($"Executing query...", MessagesPanel.MessageType.Info);
			
			var (rowCount, errorMessage, requiresConfirmation) = await ConnectionService.RunQuery(queryText, confirmedDangerous);
			
			if (requiresConfirmation)
			{
				var confirmMessage = $"⚠️ DANGEROUS OPERATION\n\n{errorMessage}\n\nThis operation could result in data loss or system changes.\n\nAre you sure you want to proceed?";
				var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", confirmMessage);
				
				if (confirmed)
				{
					await RunQuery(confirmedDangerous: true);
				}
				else
				{
					messagesPanel?.AddMessage("Query execution cancelled by user.", MessagesPanel.MessageType.Warning);
				}
				return;
			}
			
			if (string.IsNullOrEmpty(errorMessage))
			{
				messagesPanel?.AddSuccessMessage(rowCount, ConnectionService.LastQueryExecutionTimeMs);
				
				if (rowCount > 0)
				{
					ResultsGrid.DisplayResults();
					Messenger.AddInformation($"Query executed successfully. {rowCount} row(s) returned.");
				}
				else
				{
					Messenger.AddInformation("Query executed successfully. No rows returned.");
				}
			}
			else
			{
				Console.WriteLine($"Query error: {errorMessage}");
				messagesPanel?.AddErrorMessage(errorMessage);
				Messenger.AddError("Query Error", errorMessage);
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[Index] RunQuery exception: {ex.Message}");
			messagesPanel?.AddErrorMessage(ex.Message);
			Messenger.AddError("Error", $"Failed to execute query: {ex.Message}");
		}
	}

	private async Task ChangeSelectedDatabase(string selectedItem)
	{
		await ConnectionService.ChangeDatabaseAsync(selectedItem);
		StateHasChanged();
	}

	private void OnObjectExplorerDataLoaded()
	{
		Console.WriteLine("[Index] OnObjectExplorerDataLoaded - triggering StateHasChanged");
		StateHasChanged();
	}
}