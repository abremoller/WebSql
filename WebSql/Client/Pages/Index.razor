@page "/"
@using WebSql.Client.Components
@using static WebSql.Client.Pages.ConnectionDialog
@inject IConnectionService ConnectionService

<div class="container-fluid">
	<div class="row">
		<div class="col-lg-auto" style="--hx-sidebar-brand-logo-background-color: var(--bs-primary);">
			<HxSidebar>
				<ItemsTemplate>
					<HxSidebarItem Text="Server" Icon="BootstrapIcon.Cloud">
						@if(connected)
						{
							<ObjectExplorer @ref="objectExplorer" />
						}
					</HxSidebarItem>
					<HxSidebarItem Text="Connect" Icon="BootstrapIcon.CloudArrowUp">
						<HxButton OnClick="() => connectionStringDialog.Show()" />
					</HxSidebarItem>
				</ItemsTemplate>
				<FooterTemplate>
					@*<HxButton Text="Connect" Icon="BootstrapIcon.CloudArrowUp" OnClick="() => connectionStringDialog.Show()" />*@
					@*<HxSidebarFooter Text="Connect" Icon="BootstrapIcon.CloudArrowUp" />*@
					
				</FooterTemplate>
			</HxSidebar>
			

		</div>
		<div class="col">
			<HxAccordion StayOpen="true">
				<HxAccordionItem @ref="codeEditorAccordion">
					<BodyTemplate>
						@if(connected)
						{
							<HxDropdown>
								<HxDropdownToggleButton Color="ThemeColor.Secondary">@ConnectionService.SelectedDatabase</HxDropdownToggleButton>
								<HxDropdownMenu>
									@foreach(var v in ConnectionService.DatabaseNames)
									{
										<HxDropdownItem OnClick="() => ChangeSelectedDatabase(v)">@v</HxDropdownItem>	
									}
								</HxDropdownMenu>
							</HxDropdown>
							<HxButtonGroup>
								<HxButton Text="Run" Color="ThemeColor.Primary" Icon="BootstrapIcon.CaretRight" OnClick="RunQuery"/>
							</HxButtonGroup>
						}
					<CodeEditor @ref="codeEditor" />
					</BodyTemplate>
				</HxAccordionItem>
			</HxAccordion>
		</div>
	</div>
	<div class="row">
	<HxTabPanel>
			<HxTab>
				<TitleTemplate>
					<HxCardText>
						<HxIcon Icon="BootstrapIcon.Table" />
						Results
					</HxCardText>
				</TitleTemplate>
				<Content>
					<ResultsGrid @ref="ResultsGrid" />
				</Content>
			</HxTab>
			<HxTab Id="messagesTab">
				<TitleTemplate>
					<HxCardText><HxIcon Icon="BootstrapIcon.PcDisplay" />Messages</HxCardText>
				</TitleTemplate>
				<Content></Content>
			</HxTab>
		</HxTabPanel>
	</div>
</div>
	


@if (!connected)
{
	<div id="content">
		<ConnectionDialog @ref="connectionStringDialog" />
	</div>
}

@code
{
	HxAccordionItem codeEditorAccordion;
	ConnectionDialog connectionStringDialog;
	CodeEditor codeEditor;
	ObjectExplorer objectExplorer;
	ResultsGrid ResultsGrid;
	private bool connected;

	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender)
		{
			connectionStringDialog.OnDialogClose += ConnectionDialogClosed;
			connectionStringDialog.Show();
		}

		codeEditorAccordion.ExpandAsync();
	}

	public void ConnectionDialogClosed()
	{
		connected = true;
		StateHasChanged();
	}

	public async void RunQuery()
	{
		var (rowCount, errorMessage) = await ConnectionService.RunQuery(codeEditor.Text);
		if (string.IsNullOrEmpty(errorMessage))
		{
			if (rowCount > 0)
				ResultsGrid.DisplayResults();
		}
		else
		{
			// TODO: Display error message to user
			Console.WriteLine($"Query error: {errorMessage}");
		}
	}

	private async void ChangeSelectedDatabase(string selectedItem)
	{
		await ConnectionService.ChangeDatabaseAsync(selectedItem);
	}
}