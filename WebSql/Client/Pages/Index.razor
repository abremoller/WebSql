@page "/"
@using WebSql.Client.Components
@using static WebSql.Client.Pages.ConnectionDialog
@inject IConnectionService ConnectionService

<div class="row">
	<div class="col-lg-4" style="--hx-sidebar-brand-logo-background-color: var(--bs-primary);">
		<HxSidebar>
			<HeaderTemplate>
				<HxSidebarBrand BrandName="Object Explorer" BrandNameShort="SQL" />
			</HeaderTemplate>
			<ItemsTemplate>
				<ObjectExplorer />
			</ItemsTemplate>
			<FooterTemplate>
				@*<HxSidebarFooter Text="login" Icon="BootstrapIcon.Person" />*@
			</FooterTemplate>
		</HxSidebar>
	</div>
	<div class="col-lg-8">
		<HxAccordion StayOpen="true">
			<HxAccordionItem @ref="codeEditorAccordion">
				<HeaderTemplate>
					<HxButton Text="Run" Color="ThemeColor.Primary" Icon="BootstrapIcon.CaretRight" OnClick="RunQuery" style="margin:-10px;"/>
				</HeaderTemplate>
				<BodyTemplate>
					<CodeEditor @ref="codeEditor" />
				</BodyTemplate>
			</HxAccordionItem>
			@*<HxAccordionItem>
				<BodyTemplate>
					
				</BodyTemplate>
			</HxAccordionItem>*@
		</HxAccordion>
		<HxTabPanel>
			<HxTab>
				<TitleTemplate>
					<HxCardText>
						<HxIcon Icon="BootstrapIcon.Table" />
						Results
					</HxCardText>
				</TitleTemplate>
				<Content>
					<ResultsGrid />
				</Content>
			</HxTab>
			<HxTab Id="messagesTab">
				<TitleTemplate>
					<HxCardText><HxIcon Icon="BootstrapIcon.PcDisplay" />Messages</HxCardText>
				</TitleTemplate>
				<Content></Content>
			</HxTab>
		</HxTabPanel>
	</div>
</div>


            
<!-- Page Content -->
<div id="content">
    @*<HxButton Text="Connect Object Explorer" Color="ThemeColor.Primary" OnClick="() => connectionStringDialog.Show()"/>*@
    <ConnectionDialog @ref="connectionStringDialog" />

    @*<HxIcon Icon="@BootstrapIcon.HandThumbsUp" CssClass="display-3" />*@
</div>

@code
{
	HxAccordionItem codeEditorAccordion;
	ConnectionDialog connectionStringDialog;
	CodeEditor codeEditor;

	protected override void OnAfterRender(bool firstRender)
	{
		connectionStringDialog.OnDialogClose += ConnectionDialogClosed;
		connectionStringDialog.Show();

		codeEditorAccordion.ExpandAsync();
	}


	public void ConnectionDialogClosed()
	{

	}

	public void RunQuery()
	{
		ConnectionService.RunQuery(codeEditor.Text);
	}
}