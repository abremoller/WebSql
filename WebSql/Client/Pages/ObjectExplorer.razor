@using WebSql.Shared
@inject IConnectionService ConnectionService

<div class="row">
    <div class="col-lg-12" style="height: 400px">
        @if (fileSystem != null)
        {
            <HxTreeView 
                    TItem="Directory"
                    @bind-SelectedItem="selectedDirectory"
                    Items="@fileSystem"
                    CssClass="border rounded p-2"
                    ItemTitleSelector="@(p => p.Name)"
                    ItemChildrenSelector="@(p => p.Subdirectories)"
                    ItemIconSelector="@(p => p.Icon)" />
        }
    </div>
</div>

@code {
    HxTreeView<Directory> treeview;
    private Directory? selectedDirectory;
    private Directory[]? fileSystem;

    public void AddObjectExplorer(WebSql.Shared.ObjectExplorer? objectExplorer)
    {
        if (objectExplorer == null) return;
        
        Console.WriteLine("[ObjectExplorer] AddObjectExplorer called");
        fileSystem = ToTreeviewFormat(objectExplorer);
        if (fileSystem != null && fileSystem.Length > 0)
        {
            selectedDirectory = fileSystem.First();
        }
        Console.WriteLine($"[ObjectExplorer] Set {fileSystem?.Length ?? 0} databases");
        StateHasChanged();
    }

    private Directory[] ToTreeviewFormat(WebSql.Shared.ObjectExplorer explorer)
    {
        List<Directory> dataBases = new List<Directory>();

        foreach(var db in explorer.Server.Databases)
        {
            dataBases.Add(new Directory(db.Name, BootstrapIcon.Server) { Subdirectories = CreateSubDirectories(db) });
        }

        var server = new Directory(explorer.Server.ServerName ?? "Server", BootstrapIcon.Cloud);
        server.Subdirectories = dataBases.ToArray();

        Directory[] dirs = new Directory[] { server };

        return dataBases.ToArray();
    }

    private Directory[] CreateSubDirectories(Database database)
    {
        Directory[] dirs = new[]
        {
            new Directory("Tables", BootstrapIcon.Table) { Subdirectories = GetTables(database.Tables) }
        };

        return dirs;
    }

    private Directory[] GetTables(IEnumerable<Table> tables)
    {
        List<Directory> directories = new List<Directory>();

        foreach (var t in tables)
            directories.Add(new Directory(t.Name) { Icon = BootstrapIcon.Table, Subdirectories = GetTableSubDirectories(t) });

        return directories.ToArray();
    }

    private Directory[] GetColumns(IEnumerable<Column> columns)
    {
        List<Directory> cols = new List<Directory>();

        foreach(var c in columns)
        {
            cols.Add(new Directory(c.Name, BootstrapIcon.Columns) {  });
        }

        return cols.ToArray();
    }

    private Directory[] GetTableSubDirectories(Table table)
    {
        return new Directory[]
        {
            new Directory("Columns") { Subdirectories = GetColumns(table.Columns)  }
        };
    }

    public class Directory
    {
        public Directory(string name, IconBase icon = null, string message = null, ThemeColor? severity = null)
        {
            Name = name;
            Icon = icon;
            Message = message;
            Severity = severity;
        }

        public string Name { get; }

        public IconBase Icon { get; set; }

        public string Message { get; set; }

        public ThemeColor? Severity { get; set; }

        public Directory[] Subdirectories { get; set; }
    }

}