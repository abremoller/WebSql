@using WebSql.Shared
@inject IConnectionService ConnectionService

<div class="row">
    <div class="col-lg-12" style="height: 400px">
        @if (fileSystem != null)
        {
            <div class="border rounded p-2">
                <ul class="list-unstyled mb-0">
                    @foreach (var db in fileSystem)
                    {
                        var dbId = $"db_{fileSystem.ToList().IndexOf(db)}";
                        <li class="py-1">
                            <div @onclick="() => ToggleDatabase(db)" style="cursor: pointer;">
                                <HxIcon Icon="@(expandedDatabases.Contains(db) ? BootstrapIcon.ChevronDown : BootstrapIcon.ChevronRight)" CssClass="me-1" />
                                <HxIcon Icon="@BootstrapIcon.Database" CssClass="me-2" />
                                <span>@db.Name</span>
                            </div>
                            @if (expandedDatabases.Contains(db) && db.Database != null)
                            {
                                <ul class="list-unstyled ms-4 mt-1">
                                    @foreach (var table in db.Database.Tables)
                                    {
                                        <li class="py-1">
                                            <HxIcon Icon="@BootstrapIcon.Table" CssClass="me-2" />
                                            <span class="text-muted">@table.Schema.</span><span>@table.Name</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="text-muted p-2">Loading server explorer...</div>
        }
    </div>
</div>

@code {
    HxTreeView<Directory> treeview;
    private Directory? selectedDirectory;
    private Directory[]? fileSystem;
    private HashSet<Directory> expandedDatabases = new HashSet<Directory>();

    [Parameter]
    public EventCallback OnDataLoaded { get; set; }

    private void ToggleDatabase(Directory db)
    {
        if (expandedDatabases.Contains(db))
            expandedDatabases.Remove(db);
        else
            expandedDatabases.Add(db);
    }

    private IEnumerable<Directory>? GetChildren(Directory dir)
    {
        Console.WriteLine($"[ObjectExplorer] GetChildren called for: {dir.Name}");
        dir.LoadSubdirectories();
        Console.WriteLine($"[ObjectExplorer] GetChildren returning {dir.Subdirectories?.Length ?? 0} items");
        return dir.Subdirectories;
    }

    public async Task AddObjectExplorerAsync(WebSql.Shared.ObjectExplorer? objectExplorer)
    {
        if (objectExplorer == null) return;
        
        fileSystem = ToTreeviewFormat(objectExplorer);
        if (fileSystem != null && fileSystem.Length > 0)
        {
            selectedDirectory = fileSystem.First();
        }
        
        // Notify parent that data is loaded
        await OnDataLoaded.InvokeAsync();
    }

    private Directory[] ToTreeviewFormat(WebSql.Shared.ObjectExplorer explorer)
    {
        List<Directory> dataBases = new List<Directory>();

        foreach(var db in explorer.Server.Databases)
        {
            var dbDir = new Directory(db.Name, BootstrapIcon.Database);
            dbDir.Database = db;
            dataBases.Add(dbDir);
        }

        return dataBases.ToArray();
    }

    private Directory[] CreateSubDirectories(Database database)
    {
        Directory[] dirs = new[]
        {
            new Directory("Tables", BootstrapIcon.Table) { Subdirectories = GetTables(database.Tables) }
        };

        return dirs;
    }

    private Directory[] GetTables(IEnumerable<Table> tables)
    {
        List<Directory> directories = new List<Directory>();

        foreach (var t in tables)
            directories.Add(new Directory(t.Name) { Icon = BootstrapIcon.Table, Subdirectories = GetTableSubDirectories(t) });

        return directories.ToArray();
    }

    private Directory[] GetColumns(IEnumerable<Column> columns)
    {
        List<Directory> cols = new List<Directory>();

        foreach(var c in columns)
        {
            cols.Add(new Directory(c.Name, BootstrapIcon.Columns) {  });
        }

        return cols.ToArray();
    }

    private Directory[] GetTableSubDirectories(Table table)
    {
        return new Directory[]
        {
            new Directory("Columns") { Subdirectories = GetColumns(table.Columns)  }
        };
    }

    public class Directory
    {
        public Directory(string name, IconBase icon = null, string message = null, ThemeColor? severity = null)
        {
            Name = name;
            Icon = icon ?? BootstrapIcon.Folder; // Default icon if none provided
            Message = message;
            Severity = severity;
        }

        public string Name { get; }
        public IconBase Icon { get; set; }
        public string Message { get; set; }
        public ThemeColor? Severity { get; set; }
        public Directory[] Subdirectories { get; set; }
        
        public Database? Database { get; set; }
        public Table? Table { get; set; }

        public void LoadSubdirectories()
        {
            if (Subdirectories != null) return; // Already loaded

            Console.WriteLine($"[ObjectExplorer.Directory] LoadSubdirectories for: {Name}");

            if (Database != null)
            {
                Console.WriteLine($"[ObjectExplorer.Directory] Loading {Database.Tables.Count()} tables");
                // Load Tables folder
                var tablesDir = new Directory("Tables", BootstrapIcon.Table);
                tablesDir.Subdirectories = Database.Tables.Select(t => 
                {
                    var tableDir = new Directory(t.Name, BootstrapIcon.Table);
                    tableDir.Table = t;
                    return tableDir;
                }).ToArray();
                
                Subdirectories = new[] { tablesDir };
                Console.WriteLine($"[ObjectExplorer.Directory] Loaded Tables folder with {Database.Tables.Count()} items");
            }
            else if (Table != null)
            {
                Console.WriteLine($"[ObjectExplorer.Directory] Loading {Table.Columns.Count()} columns");
                // Load Columns folder
                var columnsDir = new Directory("Columns", BootstrapIcon.Columns);
                columnsDir.Subdirectories = Table.Columns.Select(c => 
                    new Directory(c.Name, BootstrapIcon.Columns)
                ).ToArray();
                
                Subdirectories = new[] { columnsDir };
                Console.WriteLine($"[ObjectExplorer.Directory] Loaded Columns folder with {Table.Columns.Count()} items");
            }
        }
    }

}