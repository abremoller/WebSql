{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyForJWT_ChangeThisInProduction_MinimumLength32Characters!",
    "Issuer": "WebSql",
    "Audience": "WebSqlClient",
    "ExpirationMinutes": 1440
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 60,
    "QueueLimit": 10
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5001", "http://localhost:5000" ]
  },
  "Security": {
    "DangerousOperationsMode": "Prompt"
  }
}
